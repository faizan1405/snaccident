# ─────────────────────────────────────────────────────────────
# SNACCIDENT — Environment variables
# Copy this file to `.env.local` and fill in real values.
# Anything WITHOUT the NEXT_PUBLIC_ prefix is server-only and must
# never be imported into a client component.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Phase 3: Database (MongoDB Atlas via Mongoose) ──
# Provisioned in Phase 3. Prefer the Vercel Marketplace MongoDB Atlas
# integration so this is injected automatically in production.
MONGODB_URI=""

# ── Phase 3: Payments (Razorpay) ──
# KEY_ID may be exposed to the client for the checkout widget; the SECRET
# is used ONLY server-side to create orders and verify signatures.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Phase 3: Transactional email (Resend) ──
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SNACCIDENT <orders@snaccident.com>"

# ── Phase 4: Admin auth (signed session) ──
# ADMIN_PASSWORD gates the /admin login; SESSION_SECRET signs the cookie.
# Generate a secret with: openssl rand -base64 32
ADMIN_PASSWORD=""
SESSION_SECRET=""
